# Conexión a mev-db (Postgres del nuevo environment "mev" en Railway)
DATABASE_URL=postgresql://user:pass@host:5432/railway

# Organización cuyos expedientes se chequean (mismo UUID que en legal-saas develop, migrado)
ORGANIZATION_ID=

# Credenciales del portal MEV (las mismas que ya se usan hoy)
MEV_USERNAME=
MEV_PASSWORD=

# Timeouts del scraper (mismos valores que legal-saas develop)
MEV_HEADLESS=1
MEV_TIMEOUT_SEC=10
MEV_TIMEOUT_LONG_SEC=15
MEV_CHECK_IDLE_TIMEOUT_MS=600000

# Notificación por mail (Resend, ya lo tenés dado de alta)
RESEND_API_KEY=
RESEND_FROM_EMAIL=reportes@alvarez-legalsaas.com.ar
RESEND_FROM_NAME=Reportes Alvarez
NOTIFY_EMAIL=Barcellajoaquin@gmail.com

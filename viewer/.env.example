# Misma DB que usa el cron (mev-db)
DATABASE_URL=postgresql://user:pass@host:5432/railway
ORGANIZATION_ID=

# Login fijo del panel
VIEWER_USERNAME=
# Generar con: npm run hash-password  (nunca pegar la contraseña en texto plano acá)
VIEWER_PASSWORD_HASH=

# Firma de las cookies de sesión — generar una vez con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

PORT=8080
